{
  "name": "black-halo-tool",
  "version": "0.3.1",
  "license": "UNLICENSED",
  "description": "Modulares Org-Tool für Star Citizen (Black Halo Enterprises)",
  "author": "Black Halo Enterprises",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "desktop": "npm run build && electron .",
    "start": "node dist/main.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/smoke.test.mjs test/input.test.mjs test/mining.test.mjs test/ocr.test.mjs test/navigation.test.mjs test/dev.test.mjs",
    "test:desktop": "npm run build && node --test test/desktop.test.mjs",
    "dist": "node scripts/check-win.mjs && npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.0.0",
    "electron-updater": "6.8.11",
    "fastify": "^5.0.0",
    "koffi": "^3.3.8",
    "onnxruntime-node": "^1.22.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "org.blackhalo.companion",
    "productName": "Black Halo",
    "executableName": "BlackHalo",
    "artifactName": "BlackHalo-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "web/**/*",
      "config/default.json",
      "assets/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Black Halo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Miroxx80",
        "repo": "BlackHaloEnterpriseCompanion"
      }
    ]
  }
}
