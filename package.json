{
  "name": "black-halo-tool",
  "version": "0.1.0",
  "description": "Modulares Org-Tool für Star Citizen (Black Halo Enterprises)",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "desktop": "npm run build && electron .",
    "start": "node dist/main.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/smoke.test.mjs",
    "test:desktop": "npm run build && node --test test/desktop.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.5.0",
    "typescript": "^5.6.0"
  }
}
